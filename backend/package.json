{
  "name": "sigaf-backend",
  "version": "1.0.0",
  "description": "API REST do SIGAF (Node.js + Express + PostgreSQL/Supabase)",
  "main": "src/server.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:setup": "node src/database/setup.js",
    "gerar-certificado": "node src/utils/gerarCertificado.js",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.js\"",
    "db:local": "node scripts/pg-local.js",
    "db:seed": "node src/database/setup.js --somente-dados",
    "db:migrar": "node src/database/migrar.js"
  },
  "author": "",
  "license": "UNLICENSED",
  "type": "module",
  "dependencies": {
    "@vercel/functions": "^3.10.4",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.2.1",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "selfsigned": "^5.5.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "@electric-sql/pglite-socket": "^0.2.15",
    "supertest": "^7.3.1"
  },
  "private": true
}
