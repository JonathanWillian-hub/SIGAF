# Servidor
PORT=3333
NODE_ENV=development

# RNF01 - HTTPS (rode "npm run gerar-certificado" e mude para true)
HTTPS_ENABLED=false
HTTPS_PORT=3443

# Banco de dados MySQL / MariaDB
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=sigaf

# Autenticação (JWT)
JWT_SECRET=troque-esta-chave-em-producao
JWT_EXPIRES_IN=8h

# RNF01 - Chave AES-256 (64 caracteres hexadecimais = 32 bytes)
ENCRYPTION_KEY=6f1c2d9a8b7e4f3a2c1d0e9f8a7b6c5d4e3f2a1b0c9d8e7f6a5b4c3d2e1f0a9b

# RF04 A1 - acima deste número de registros o relatório é gerado em segundo plano
REPORT_ASYNC_THRESHOLD=100

# Serviço de Notificação por e-mail (opcional; vazio = só notificação no sistema)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="SIGAF <nao-responda@sigaf.com.br>"
