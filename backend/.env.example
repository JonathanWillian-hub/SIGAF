# Servidor
PORT=3333
NODE_ENV=development

# RNF01 - HTTPS (rode "npm run gerar-certificado" e mude para true)
HTTPS_ENABLED=false
HTTPS_PORT=3443

# Banco de dados PostgreSQL no Supabase
# Painel do projeto > botão "Connect" > "Session pooler" > copie a URI e troque [YOUR-PASSWORD] pela senha do banco.
DATABASE_URL=postgresql://postgres.SEU_PROJETO:[YOUR-PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
# Na Vercel use o "Transaction pooler" (mesma URI, porta 6543) e DB_POOL_MAX=10
DB_POOL_MAX=10
# Schema onde ficam as tabelas do SIGAF
DB_SCHEMA=public
# Opcional: caminho do certificado baixado em Database > SSL Configuration (valida o servidor)
DB_SSL_CA=
# Para usar o Postgres local (npm run db:local), troque por:
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/postgres
# DB_SSL=false

# Autenticação (JWT)
JWT_SECRET=troque-esta-chave-em-producao
JWT_EXPIRES_IN=8h

# RNF01 - Chave AES-256 (64 caracteres hexadecimais = 32 bytes)
ENCRYPTION_KEY=6f1c2d9a8b7e4f3a2c1d0e9f8a7b6c5d4e3f2a1b0c9d8e7f6a5b4c3d2e1f0a9b

# RF04 A1 - acima deste número de registros o relatório é gerado em segundo plano
REPORT_ASYNC_THRESHOLD=100

# Serviço de Notificação por e-mail (opcional; vazio = só notificação no sistema)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="SIGAF <nao-responda@sigaf.com.br>"
